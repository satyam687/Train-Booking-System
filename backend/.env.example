DEBUG=True
SECRET_KEY=django-insecure-railbook-ai-smart-super-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_NAME=backend/db.sqlite3

# External Train Status API Configuration (Optional provider credentials)
TRAIN_API_PROVIDER=mock
TRAIN_API_BASE_URL=https://api.railway-sample-provider.internal/v1
TRAIN_API_KEY=
TRAIN_API_CACHE_TTL_SECONDS=300

# Authorized Railway Fare API Configuration
# To connect an authentic provider, set RAILWAY_FARE_API_KEY and RAILWAY_FARE_API_PROVIDER
RAILWAY_FARE_API_KEY=
RAILWAY_FARE_API_URL=https://api.railway-fare-provider.internal/v1
RAILWAY_FARE_API_PROVIDER=
FARE_CACHE_TTL_MINUTES=60

# Apify IRCTC Train Data Scraper Actor (scrapingshark/irctc-train-data-scraper)
# Add your Apify API Token here to fetch live IRCTC fares & seat availability
APIFY_API_TOKEN=
APIFY_ACTOR_ID=scrapingshark/irctc-train-data-scraper

# ML Configuration
ML_MODEL_DIR=ml/artifacts
DEMO_MODE=True
